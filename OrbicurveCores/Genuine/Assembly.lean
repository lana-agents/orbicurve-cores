import OrbicurveCores.S1.Main
import OrbicurveCores.GroupCanLift
import OrbicurveCores.Genuine.HemiCore

/-!
# Assembly of `CanLift27Genuine` from U1, S1, the group level, and three precise interfaces

`CanLift27Genuine` (`Reconcile.lean`) asks for a genuine `k`-core of `E ∖ {0}` for every elliptic
curve `E` over a field `k` of characteristic `0` with non-exceptional `j`. Following [CanLift]
Prop. 2.7, the core is the punctured hemi-elliptic orbicurve `(E ∖ {0}) / ±1` (pi1's
`AffOrbicurve.hemi E`). This file reduces `CanLift27Genuine` to three statements (Blueprint §2.6):

* `CommIndexFour` (**R3**, group level): a once-punctured torus group `Γ` that admits a core has
  index `4` in its commensurator (in `SL(2, ℝ)`), i.e. `Comm(Γ) = ⟨Γ, ι⟩` where `ι` (of order
  `4`, `ι² = -1`) induces the elliptic involution;
* `HemiCoreComplex` (**U2 over `ℂ`**): if `(A, B)` uniformises `E ∖ {0}` over `ℂ` and `⟨A, B⟩` has
  index `4` in its commensurator, then `(E ∖ {0}) / ±1` is the `ℂ`-core of `E ∖ {0}`;
* `HemiCoreTransfer` (**[CanLift] Prop. 2.3 + Lefschetz principle**): if `(E ∖ {0}) / ±1` is the
  core of `E ∖ {0}` for every complex `E` with non-exceptional `j`, then the same holds over
  every field of characteristic `0`.

Given these, the proved inputs are U1 (`uniformization`, from `lana-agents/oka`), S1
(`S1.not_takeuchi_of_nonExceptional`) and the group-level theorem
(`canLift27_group_unconditional`, with Margulis `M2.margulisDenseOneInfty`).

Main results:

* `hemiCore_complex_of`: `CommIndexFour → HemiCoreComplex →` the complex case of pi1's
  `CanLift27`;
* `canLift27_of`: pi1's `AffOrbicurve.CanLift27` from the three interfaces;
* `canLift27Genuine_of`: `CanLift27Genuine` from the three interfaces;
* `hemiCoreComplex_of`: U2 over `ℂ` from its descent half `U2Descent` and rigidity half
  `U2Rigidity` (`Genuine/HemiCore.lean` does the algebra);
* `canLift27Genuine_of'`: `CanLift27Genuine` from `CommIndexFour`, `U2Descent`, `U2Rigidity` and
  `HemiCoreTransfer`.
-/

open Matrix
open Subgroup.Commensurable (commensurator)
open scoped MatrixGroups

universe u

namespace OrbicurveCores

/-- **R3** ([CanLift] Prop. 2.7, Riemann–Hurwitz step, group form): a once-punctured torus group
that admits a core has index `4` in its commensurator in `SL(2, ℝ)`: the commensurator is
generated by `Γ`, `-1` and a lift `ι` of the elliptic involution (Blueprint §4, R3). -/
def CommIndexFour : Prop :=
  ∀ A B : SL(2, ℝ), tr (A * B * A⁻¹ * B⁻¹) = -2 → tr A ≠ 0 →
    AdmitsCore (Subgroup.closure {A, B}) →
      (Subgroup.closure {A, B}).relIndex (commensurator (Subgroup.closure {A, B})) = 4

/-- **U2 over `ℂ`**: if `(A, B)` uniformises `E ∖ {0}` and `Comm(⟨A, B⟩) : ⟨A, B⟩` has index `4`,
then the punctured hemi-elliptic orbicurve is the `ℂ`-core of `E ∖ {0}` in the sense of
[CanLift] Def. 2.1. (Proof outline: Blueprint §2.6, items U2a–U2e.) -/
def HemiCoreComplex : Prop :=
  ∀ (E : WeierstrassCurve ℂ) [E.IsElliptic] (A B : SL(2, ℝ)),
    tr (A * B * A⁻¹ * B⁻¹) = -2 → tr A ≠ 0 → Uniformizes E A B →
      (Subgroup.closure {A, B}).relIndex (commensurator (Subgroup.closure {A, B})) = 4 →
        AffOrbicurve.IsCoreOf (AffOrbicurve.punctured E) (AffOrbicurve.hemi E)

/-- **U2, descent half, over `ℂ`** (Blueprint §2.6, U2b–U2d): with the hypotheses of
`HemiCoreComplex`, the `x`-coordinate of a finite étale cover `Z → E ∖ 0` descends along every
finite étale `Z → Y`. -/
def U2Descent : Prop :=
  ∀ (E : WeierstrassCurve ℂ) [E.IsElliptic] (A B : SL(2, ℝ)),
    tr (A * B * A⁻¹ * B⁻¹) = -2 → tr A ≠ 0 → Uniformizes E A B →
      (Subgroup.closure {A, B}).relIndex (commensurator (Subgroup.closure {A, B})) = 4 →
        Genuine.HemiDescends E

/-- **U2, rigidity half, over `ℂ`** (Blueprint §2.6, U2e): with the hypotheses of
`HemiCoreComplex`, every finite étale `Z → (E ∖ 0)/±1` from a finite étale cover
`p : Z → E ∖ 0` is `x ∘ p`. -/
def U2Rigidity : Prop :=
  ∀ (E : WeierstrassCurve ℂ) [E.IsElliptic] (A B : SL(2, ℝ)),
    tr (A * B * A⁻¹ * B⁻¹) = -2 → tr A ≠ 0 → Uniformizes E A B →
      (Subgroup.closure {A, B}).relIndex (commensurator (Subgroup.closure {A, B})) = 4 →
        Genuine.HemiRigid E

/-- U2 over `ℂ` from its descent and rigidity halves (`Genuine.isCoreOf_hemi_of`). -/
theorem hemiCoreComplex_of (hD : U2Descent) (hR : U2Rigidity) : HemiCoreComplex :=
  fun E _ A B hc hA hU hi ↦
    Genuine.isCoreOf_hemi_of E (hD E A B hc hA hU hi) (hR E A B hc hA hU hi)

/-- The complex case of pi1's `CanLift27`. -/
def HemiCoreComplexNonExc : Prop :=
  ∀ (E : WeierstrassCurve ℂ) [E.IsElliptic], (∀ c ∈ AffOrbicurve.excJ, E.j ≠ (c : ℂ)) →
    AffOrbicurve.IsCoreOf (AffOrbicurve.punctured E) (AffOrbicurve.hemi E)

/-- **Transfer** ([CanLift] Prop. 2.3(i),(ii) and the Lefschetz principle, [Corr] Lemma 4.1):
the statement "the hemi-elliptic quotient is the core" passes from `ℂ` to every field of
characteristic `0`. (Proof outline: Blueprint §2.6, items T1–T3.) -/
def HemiCoreTransfer : Prop :=
  HemiCoreComplexNonExc → AffOrbicurve.CanLift27.{u}

/-- The complex case of [CanLift] Prop. 2.7 from R3 and U2 over `ℂ`, using U1, S1, and the
group-level theorem (Margulis, Takeuchi, sharpness). -/
theorem hemiCoreComplexNonExc_of (hR3 : CommIndexFour) (hU2 : HemiCoreComplex) :
    HemiCoreComplexNonExc := by
  intro E _ hj
  obtain ⟨A, B, hc, hA, hU⟩ := uniformization E
  have hT := S1.not_takeuchi_of_nonExceptional E A B hU hj
  have hcore : AdmitsCore (Subgroup.closure {A, B}) := by
    by_contra h
    exact hT ((canLift27_group_unconditional hc hA).1 h)
  exact hU2 E A B hc hA hU (hR3 A B hc hA hcore)

/-- pi1's `AffOrbicurve.CanLift27` from the three interfaces. -/
theorem canLift27_of (hR3 : CommIndexFour) (hU2 : HemiCoreComplex)
    (hT : HemiCoreTransfer.{u}) : AffOrbicurve.CanLift27.{u} :=
  hT (hemiCoreComplexNonExc_of hR3 hU2)

/-- **`CanLift27Genuine` from R3, the two halves of U2 over `ℂ`, and the transfer.** -/
theorem canLift27Genuine_of' (hR3 : CommIndexFour) (hD : U2Descent) (hR : U2Rigidity)
    (hT : HemiCoreTransfer.{u}) : CanLift27Genuine.{u} :=
  canLift27Genuine_of_canLift27 (canLift27_of hR3 (hemiCoreComplex_of hD hR) hT)

/-- **`CanLift27Genuine` from R3, U2 over `ℂ`, and the transfer.** -/
theorem canLift27Genuine_of (hR3 : CommIndexFour) (hU2 : HemiCoreComplex)
    (hT : HemiCoreTransfer.{u}) : CanLift27Genuine.{u} :=
  canLift27Genuine_of_canLift27 (canLift27_of hR3 hU2 hT)

end OrbicurveCores
