import Mathlib.RingTheory.DiscreteValuationRing.TFAE
import Mathlib.RingTheory.Filtration

/-!
# T2a: a DVR criterion

A Noetherian local ring whose maximal ideal is generated by a non-zero-divisor `π` is a domain
(every nonzero element is `u π ^ n` with `u` a unit, by the Krull intersection theorem), hence a
discrete valuation ring.
-/

open IsLocalRing

namespace OrbicurveCores.Transfer

variable {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]

/-- Every nonzero element of a Noetherian local ring with principal maximal ideal `(π)` is a unit
times a power of `π`. -/
lemma exists_unit_mul_pow_of_maximalIdeal_eq {π : R} (hπ : maximalIdeal R = Ideal.span {π})
    {x : R} (hx : x ≠ 0) : ∃ (n : ℕ) (u : Rˣ), x = u * π ^ n := by
  have hI := Ideal.iInf_pow_eq_bot_of_isLocalRing (maximalIdeal R) (maximalIdeal.isMaximal R).ne_top
  have hex : ∃ n, x ∉ maximalIdeal R ^ n := by
    by_contra h
    push Not at h
    apply hx
    have : x ∈ ⨅ n, maximalIdeal R ^ n := Ideal.mem_iInf.mpr h
    rw [hI] at this
    exact this
  classical
  let n := Nat.find hex
  have hn : x ∉ maximalIdeal R ^ n := Nat.find_spec hex
  have hn0 : n ≠ 0 := by
    intro h0
    apply hn
    rw [h0, pow_zero, Ideal.one_eq_top]
    trivial
  obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hn0
  have hxm : x ∈ maximalIdeal R ^ m := by
    have := Nat.find_min hex (show m < n by omega)
    push Not at this
    exact this
  rw [hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hxm
  obtain ⟨a, rfl⟩ := hxm
  have ha : a ∉ maximalIdeal R := by
    intro ha
    apply hn
    rw [hm, hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
    rw [hπ, Ideal.mem_span_singleton'] at ha
    obtain ⟨b, rfl⟩ := ha
    exact ⟨b, by rw [pow_succ]; ring⟩
  exact ⟨m, (IsLocalRing.notMem_maximalIdeal.mp ha).unit, rfl⟩

/-- A Noetherian local ring whose maximal ideal is generated by a non-zero-divisor is a domain. -/
lemma isDomain_of_maximalIdeal_eq {π : R} (hπ : maximalIdeal R = Ideal.span {π})
    (hπnz : π ∈ nonZeroDivisors R) : IsDomain R := by
  have : NoZeroDivisors R := by
    refine ⟨fun {x y} hxy ↦ ?_⟩
    by_contra h
    push Not at h
    obtain ⟨n, u, rfl⟩ := exists_unit_mul_pow_of_maximalIdeal_eq hπ h.1
    obtain ⟨m, u', rfl⟩ := exists_unit_mul_pow_of_maximalIdeal_eq hπ h.2
    have h1 : π ^ (n + m) * ((u * u' : Rˣ) : R) = 0 := by
      rw [← hxy, Units.val_mul, pow_add]; ring
    have h2 := (pow_mem hπnz (n + m)).2 _ (by rw [mul_comm]; exact h1)
    exact (u * u').ne_zero h2
  exact NoZeroDivisors.to_isDomain R

/-- **DVR criterion**: a Noetherian local ring whose maximal ideal is generated by a
non-zero-divisor is a discrete valuation ring. -/
lemma isDiscreteValuationRing_of_maximalIdeal_eq {π : R} (hπ : maximalIdeal R = Ideal.span {π})
    (hπnz : π ∈ nonZeroDivisors R) :
    ∃ _ : IsDomain R, IsDiscreteValuationRing R := by
  have hD := isDomain_of_maximalIdeal_eq hπ hπnz
  refine ⟨hD, ?_⟩
  have hnf : ¬ IsField R := by
    intro hF
    have h0 : maximalIdeal R = ⊥ := by
      letI := hF.toField
      exact IsLocalRing.maximalIdeal_eq_bot
    have : π ∈ maximalIdeal R := by rw [hπ]; exact Ideal.mem_span_singleton_self π
    rw [h0, Ideal.mem_bot] at this
    exact one_ne_zero (hπnz.2 1 (by rw [one_mul, this]))
  exact ((IsDiscreteValuationRing.TFAE R hnf).out 4 0).mp (⟨⟨π, hπ⟩⟩ : (maximalIdeal R).IsPrincipal)

end OrbicurveCores.Transfer
