import OrbicurveCores.Genuine.Transfer.Generic
import OrbicurveCores.Genuine.Transfer.Local
import OrbicurveCores.Genuine.Transfer.Normalization
import Mathlib.RingTheory.PolynomialAlgebra
import Mathlib.RingTheory.Flat.TorsionFree
import OrbicurveCores.Genuine.Transfer.Components

/-!
# T2c, generic case: local structure of `K ⊗_k A` over the generic point

Let `A` be a domain, finite over `k[t]` (`k` of characteristic `0`), and `K / k` a field
extension. View `T = K ⊗_k A` as a `K[t]`-algebra; it is the base change of the `k[t]`-algebra
`A` (`isPushout_polynomial`). For a maximal ideal `M` of `T` with `M ∩ A = 0`, `T` is unramified
over `K[t]` at `M` (generic unramifiedness), so the maximal ideal of `T_M` is generated by a
generator `h` of the maximal ideal `M ∩ K[t]` of the principal ideal domain `K[t]`, a
non-zero-divisor (`T` is flat over `K[t]`). Hence `T_M` is a discrete valuation ring
(`isDVR_generic`).
-/

open TensorProduct IsLocalRing Polynomial

namespace OrbicurveCores.Transfer

variable {k K A : Type*} [Field k] [Field K] [Algebra k K] [CommRing A] [Algebra k A]

attribute [local instance] Algebra.TensorProduct.rightAlgebra Polynomial.algebra

section Setup

variable [Algebra k[X] A] [IsScalarTower k k[X] A]

variable (k K A) in
/-- `K ⊗_k A` as a `k[t]`-algebra, through `A`. -/
@[reducible] noncomputable def algPolyTensor : Algebra k[X] (K ⊗[k] A) :=
  ((algebraMap A (K ⊗[k] A)).comp (algebraMap k[X] A)).toAlgebra

variable (k K A) in
/-- `K ⊗_k A` as a `K[t]`-algebra (`t ↦ 1 ⊗ t`). -/
@[reducible] noncomputable def algPolyTensor' : Algebra K[X] (K ⊗[k] A) :=
  (Polynomial.aeval ((1 : K) ⊗ₜ[k] algebraMap k[X] A X)).toRingHom.toAlgebra

attribute [local instance] algPolyTensor algPolyTensor'

instance : IsScalarTower k[X] A (K ⊗[k] A) := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl

instance : IsScalarTower K K[X] (K ⊗[k] A) := IsScalarTower.of_algebraMap_eq fun x ↦ by
  change _ = Polynomial.aeval _ (Polynomial.C x)
  rw [Polynomial.aeval_C]

instance : IsScalarTower k K[X] (K ⊗[k] A) := IsScalarTower.of_algebraMap_eq fun x ↦ by
  rw [IsScalarTower.algebraMap_apply k K K[X], ← IsScalarTower.algebraMap_apply K K[X],
    ← IsScalarTower.algebraMap_apply]

instance : IsScalarTower k[X] K[X] (K ⊗[k] A) := IsScalarTower.of_algebraMap_eq' <| by
  refine Polynomial.ringHom_ext (fun c ↦ ?_) ?_
  · change (1 : K) ⊗ₜ[k] algebraMap k[X] A (Polynomial.C c) =
      Polynomial.aeval _ (Polynomial.map (algebraMap k K) (Polynomial.C c))
    rw [Polynomial.map_C, Polynomial.aeval_C, ← Polynomial.algebraMap_eq,
      ← IsScalarTower.algebraMap_apply, Algebra.algebraMap_eq_smul_one c,
      Algebra.algebraMap_eq_smul_one c, ← TensorProduct.smul_tmul]
    rfl
  · change (1 : K) ⊗ₜ[k] algebraMap k[X] A X = Polynomial.aeval _ (Polynomial.map _ X)
    rw [Polynomial.map_X, Polynomial.aeval_X]

/-- `K ⊗_k A` is the base change of the `k[t]`-algebra `A` along `k[t] → K[t]`. -/
instance isPushout_polynomial : Algebra.IsPushout k[X] K[X] A (K ⊗[k] A) :=
  (Algebra.IsPushout.comp_iff (R := k) (S := k[X]) (T := A) (R' := K) (S' := K[X])
    (T' := K ⊗[k] A)).mp inferInstance |>.symm

variable [IsDomain A] [Module.Finite k[X] A] [FaithfulSMul k[X] A]

/-- **Local structure over the generic point** (T2c, generic case): if `M` is a maximal ideal of
`K ⊗_k A` with `M ∩ A = 0`, then the maximal ideal of `(K ⊗_k A)_M` is generated by
`M ∩ K[t]`. -/
theorem map_comap_eq_maximalIdeal_generic [CharZero k] (M : Ideal (K ⊗[k] A)) [M.IsMaximal]
    (hM : M.comap (algebraMap A (K ⊗[k] A)) = ⊥) :
    (M.comap (algebraMap K[X] (K ⊗[k] A))).map (algebraMap K[X] (Localization.AtPrime M)) =
      maximalIdeal (Localization.AtPrime M) := by
  have : Module.IsTorsionFree k[X] A :=
    (Module.isTorsionFree_iff_algebraMap_injective).mpr (FaithfulSMul.algebraMap_injective _ _)
  obtain ⟨a, ha0, ha⟩ := exists_ne_zero_smul_kaehler_eq_zero (D := k[X]) (A := A)
  have haM : algebraMap A (K ⊗[k] A) a ∉ M := by
    intro h
    have : a ∈ M.comap (algebraMap A (K ⊗[k] A)) := h
    rw [hM, Ideal.mem_bot] at this
    exact ha0 this
  have : Module.Finite K[X] (K ⊗[k] A) :=
    Module.Finite.equiv (Algebra.IsPushout.equiv k[X] K[X] A (K ⊗[k] A)).toLinearEquiv
  exact map_comap_eq_maximalIdeal_of_smul_kaehler (D := k[X]) (R' := K[X]) ha M haM

omit [IsDomain A] [FaithfulSMul k[X] A] in
/-- The contraction of a maximal ideal of `K ⊗_k A` to `K[t]` is maximal. -/
lemma isMaximal_comap_polynomial (M : Ideal (K ⊗[k] A)) [M.IsMaximal] :
    (M.comap (algebraMap K[X] (K ⊗[k] A))).IsMaximal := by
  have : Module.Finite K[X] (K ⊗[k] A) :=
    Module.Finite.equiv (Algebra.IsPushout.equiv k[X] K[X] A (K ⊗[k] A)).toLinearEquiv
  exact Ideal.isMaximal_comap_of_isIntegral_of_isMaximal M

/-- **Local structure over the generic point** (T2c, generic case): if `M` is a maximal ideal of
`K ⊗_k A` with `M ∩ A = 0`, then the maximal ideal of `(K ⊗_k A)_M` is generated by the image of
a nonzero `h ∈ K[t]` with `h ∈ M`. -/
theorem maximalIdeal_eq_span_generic [CharZero k] (M : Ideal (K ⊗[k] A)) [M.IsMaximal]
    (hM : M.comap (algebraMap A (K ⊗[k] A)) = ⊥) :
    ∃ h : K[X], h ≠ 0 ∧ algebraMap K[X] (K ⊗[k] A) h ∈ M ∧
      maximalIdeal (Localization.AtPrime M) =
        Ideal.span {algebraMap K[X] (Localization.AtPrime M) h} := by
  have hmax := map_comap_eq_maximalIdeal_generic M hM
  set 𝔫 := M.comap (algebraMap K[X] (K ⊗[k] A))
  have h𝔫 : 𝔫.IsMaximal := isMaximal_comap_polynomial M
  set h := Submodule.IsPrincipal.generator 𝔫
  have hspan : Ideal.span {h} = 𝔫 := Ideal.span_singleton_generator 𝔫
  refine ⟨h, ?_, ?_, ?_⟩
  · intro h0
    rw [h0, Ideal.span_singleton_eq_bot.mpr rfl] at hspan
    exact Ring.ne_bot_of_isMaximal_of_not_isField h𝔫 (Polynomial.not_isField K) hspan.symm
  · have : h ∈ 𝔫 := hspan ▸ Ideal.mem_span_singleton_self h
    exact this
  · rw [← hmax, ← hspan, Ideal.map_span, Set.image_singleton]

/-- **T2c, generic case**: at a maximal ideal `M` of `K ⊗_k A` with `M ∩ A = 0`, the local ring
is a discrete valuation ring. -/
theorem isDVR_generic [CharZero k] (M : Ideal (K ⊗[k] A)) [M.IsMaximal]
    (hM : M.comap (algebraMap A (K ⊗[k] A)) = ⊥) :
    ∃ _ : IsDomain (Localization.AtPrime M), IsDiscreteValuationRing (Localization.AtPrime M) := by
  obtain ⟨h, h0, -, hmax⟩ := maximalIdeal_eq_span_generic M hM
  have : Module.IsTorsionFree k[X] A :=
    (Module.isTorsionFree_iff_algebraMap_injective).mpr (FaithfulSMul.algebraMap_injective _ _)
  have : Module.Flat K[X] (K ⊗[k] A) :=
    Module.Flat.isBaseChange k[X] K[X] A (K ⊗[k] A) (Algebra.IsPushout.out)
  have : Module.Finite K[X] (K ⊗[k] A) :=
    Module.Finite.equiv (Algebra.IsPushout.equiv k[X] K[X] A (K ⊗[k] A)).toLinearEquiv
  have : IsNoetherianRing (K ⊗[k] A) := IsNoetherianRing.of_finite K[X] (K ⊗[k] A)
  refine isDiscreteValuationRing_of_maximalIdeal_eq hmax ?_
  have hreg : IsSMulRegular (K ⊗[k] A) h :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero h0)
  have hnz : algebraMap K[X] (K ⊗[k] A) h ∈ nonZeroDivisors (K ⊗[k] A) := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply hreg
    change h • x = h • 0
    rw [smul_zero, Algebra.smul_def, mul_comm, hx]
  rw [IsScalarTower.algebraMap_apply K[X] (K ⊗[k] A)]
  exact IsLocalization.map_nonZeroDivisors_le M.primeCompl _ ⟨_, hnz, rfl⟩

end Setup

/-- **T2c**: for a Dedekind domain `A` of finite type over `k` (characteristic `0`) which is not a
field, and any field extension `K / k`, every localization of `K ⊗_k A` at a maximal ideal is a
discrete valuation ring. -/
theorem locallyDVR_tensor [CharZero k] [IsDedekindDomain A] [Algebra.FiniteType k A]
    (hA : ¬ IsField A) : LocallyDVR (K ⊗[k] A) := by
  intro M _
  by_cases hv : M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A) = ⊥
  · obtain ⟨t, ht, hfin⟩ := exists_finite_polynomial k A hA
    letI : Algebra k[X] A := t.toRingHom.toAlgebra
    haveI : IsScalarTower k k[X] A := IsScalarTower.of_algebraMap_eq fun c ↦ by
      change _ = t (Polynomial.C c)
      rw [← Polynomial.algebraMap_eq, AlgHom.commutes]
    haveI : Module.Finite k[X] A := hfin
    haveI : FaithfulSMul k[X] A := (faithfulSMul_iff_algebraMap_injective _ _).mpr ht
    exact isDVR_generic M hv
  · exact isDVR_closed M hv

end OrbicurveCores.Transfer
