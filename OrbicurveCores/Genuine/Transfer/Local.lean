import OrbicurveCores.Genuine.Transfer.DVR
import Mathlib.RingTheory.Unramified.Field
import Mathlib.RingTheory.DedekindDomain.Dvr
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.LinearAlgebra.TensorProduct.RightExactness
import Mathlib.RingTheory.KrullDimension.Zero
import Mathlib.RingTheory.LocalProperties.Reduced

/-!
# T2b–T2c: local structure of `K ⊗_k A` at points over closed points

Let `A` be a Dedekind domain of finite type over a field `k` of characteristic `0`, and `K / k`
a field extension. For a maximal ideal `M` of `T = K ⊗_k A` whose contraction `v = M ∩ A` is
nonzero (hence maximal), the fibre `T / vT = K ⊗_k (A / v)` is reduced and zero-dimensional
(`A / v` is a finite separable extension of `k`), so `vT_M` is the maximal ideal of `T_M`; it is
generated by a uniformizer `π` of `A` at `v`, a non-zero-divisor of `T_M`. Hence `T_M` is a
discrete valuation ring with uniformizer `π` (`isDVR_closed`).
-/

open TensorProduct IsLocalRing

namespace OrbicurveCores.Transfer

/-- In a reduced ring of dimension zero, every element of a maximal ideal is killed by an
element outside it. -/
lemma exists_notMem_mul_eq_zero {R : Type*} [CommRing R] [IsReduced R] [IsArtinianRing R]
    (m : Ideal R) [m.IsMaximal] {a : R} (ha : a ∈ m) : ∃ s ∉ m, s * a = 0 := by
  let S := Localization.AtPrime m
  have hF : IsField S := IsArtinianRing.isField_of_isReduced_of_isLocalRing S
  have h0 : algebraMap R S a = 0 := by
    letI := hF.toField
    have hmem : algebraMap R S a ∈ maximalIdeal S := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.mem_map_of_mem _ ha
    rwa [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot] at hmem
  obtain ⟨⟨s, hs⟩, h⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl S a).mp h0
  exact ⟨s, hs, h⟩

section Closed

variable {k K A : Type*} [Field k] [Field K] [Algebra k K] [CommRing A] [Algebra k A]

/-- The fibre of `K ⊗_k A` over a maximal ideal `v` of `A` is reduced and zero-dimensional:
every element of a maximal ideal `M ⊇ v` is, up to a factor outside `M`, in `v (K ⊗ A)`. -/
lemma exists_notMem_mul_mem_map [CharZero k] [Algebra.FiniteType k A] (v : Ideal A) [v.IsMaximal]
    (M : Ideal (K ⊗[k] A)) [M.IsMaximal]
    (hvM : v.map (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A) ≤ M) {m : K ⊗[k] A}
    (hm : m ∈ M) :
    ∃ s ∉ M, s * m ∈ v.map (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A) := by
  letI : Field (A ⧸ v) := Ideal.Quotient.field v
  have : Module.Finite k (A ⧸ v) := finite_of_finite_type_of_isJacobsonRing k (A ⧸ v)
  have : Algebra.IsSeparable k (A ⧸ v) := Algebra.IsSeparable.of_integral k (A ⧸ v)
  have : Algebra.FormallyUnramified k (A ⧸ v) := Algebra.FormallyUnramified.of_isSeparable k _
  let g : A →ₐ[k] A ⧸ v := Ideal.Quotient.mkₐ k v
  have hg : Function.Surjective g := Ideal.Quotient.mkₐ_surjective k v
  let φ : K ⊗[k] A →ₐ[k] K ⊗[k] (A ⧸ v) := Algebra.TensorProduct.map (AlgHom.id k K) g
  have hφ : Function.Surjective φ := Algebra.TensorProduct.map_surjective _ _
    Function.surjective_id hg
  have hker : RingHom.ker φ = v.map (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A) := by
    rw [Algebra.TensorProduct.lTensor_ker _ hg]
    congr 1
    exact Ideal.Quotient.mkₐ_ker k v
  have hkerM : RingHom.ker φ ≤ M := hker ▸ hvM
  let M' := M.map φ
  have : M'.IsMaximal := by
    refine (Ideal.map_eq_top_or_isMaximal_of_surjective φ hφ ‹_›).resolve_left fun h ↦ ?_
    have := Ideal.comap_map_of_surjective φ hφ M
    rw [h, Ideal.comap_top] at this
    exact ‹M.IsMaximal›.ne_top (this.trans (sup_eq_left.mpr fun x hx ↦ hkerM hx)).symm
  have : Module.Finite K (K ⊗[k] (A ⧸ v)) := inferInstance
  have : IsArtinianRing (K ⊗[k] (A ⧸ v)) := IsArtinianRing.of_finite K _
  have : IsReduced (K ⊗[k] (A ⧸ v)) := Algebra.FormallyUnramified.isReduced_of_field K _
  obtain ⟨s', hs', hs'm⟩ := exists_notMem_mul_eq_zero M' (Ideal.mem_map_of_mem φ hm)
  obtain ⟨s, rfl⟩ := hφ s'
  refine ⟨s, fun hs ↦ hs' (Ideal.mem_map_of_mem φ hs), ?_⟩
  rw [← hker, RingHom.mem_ker, map_mul]
  exact hs'm

omit [Algebra k A] in
/-- A local generator at a nonzero prime `v` of a Dedekind domain: `π ∈ v`, `π ≠ 0`, and every
`a ∈ v` satisfies `s a = π b` for some `s ∉ v`. -/
lemma exists_local_uniformizer [IsDedekindDomain A] (v : Ideal A) [v.IsPrime] (hv : v ≠ ⊥) :
    ∃ π : A, π ≠ 0 ∧ π ∈ v ∧ ∀ a ∈ v, ∃ s ∉ v, ∃ b, s * a = π * b := by
  let Av := Localization.AtPrime v
  have : IsDiscreteValuationRing Av :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain A hv Av
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible Av
  obtain ⟨⟨π, t⟩, rfl⟩ := IsLocalization.mk'_surjective v.primeCompl ϖ
  have ht : IsUnit (algebraMap A Av t) := IsLocalization.map_units Av t
  have hπϖ : algebraMap A Av π = IsLocalization.mk' Av π t * algebraMap A Av t := by
    rw [IsLocalization.mk'_spec]
  have hmax : maximalIdeal Av = Ideal.span {algebraMap A Av π} := by
    rw [hπϖ, Ideal.span_singleton_mul_right_unit ht,
      ← (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hϖ]
  have hinj : Function.Injective (algebraMap A Av) :=
    IsLocalization.injective Av v.primeCompl_le_nonZeroDivisors
  refine ⟨π, ?_, ?_, ?_⟩
  · rintro rfl
    rw [map_zero, Ideal.span_singleton_eq_bot.mpr rfl] at hmax
    exact hϖ.ne_zero (by
      have : IsLocalization.mk' Av (0 : A) t ∈ maximalIdeal Av := by
        rw [IsLocalization.mk'_zero]; exact Ideal.zero_mem _
      rw [hmax] at this
      exact (Ideal.mem_bot.mp this))
  · rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff Av v, hmax]
    exact Ideal.mem_span_singleton_self _
  · intro a ha
    have : algebraMap A Av a ∈ maximalIdeal Av :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff Av v a).mpr ha
    rw [hmax, Ideal.mem_span_singleton'] at this
    obtain ⟨c, hc⟩ := this
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective v.primeCompl c
    dsimp only at hc
    refine ⟨s, s.2, b, hinj ?_⟩
    rw [map_mul, map_mul, ← hc, ← mul_assoc, IsLocalization.mk'_spec', mul_comm]

/-- **Local structure at points over closed points** (T2c, closed case), for a given local
uniformizer: if `M` is a maximal ideal of `K ⊗_k A` with `v = M ∩ A ≠ 0`, and `π` generates `v`
locally, then the maximal ideal of `(K ⊗_k A)_M` is generated by `1 ⊗ π`. -/
theorem maximalIdeal_eq_span_closed_of [CharZero k] [Algebra.FiniteType k A] [IsDedekindDomain A]
    (M : Ideal (K ⊗[k] A)) [M.IsMaximal]
    (hv : M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A) ≠ ⊥) {π : A}
    (hπv : π ∈ M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A))
    (hπ : ∀ a ∈ M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A),
      ∃ s ∉ M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A), ∃ b, s * a = π * b) :
    maximalIdeal (Localization.AtPrime M) = Ideal.span
        {algebraMap _ (Localization.AtPrime M) ((1 : K) ⊗ₜ[k] π)} := by
  set ι : A →ₐ[k] K ⊗[k] A := Algebra.TensorProduct.includeRight
  set v := M.comap ι with hvdef
  have : v.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hv
  set S := Localization.AtPrime M
  have hunit : ∀ s ∉ v, IsUnit (algebraMap _ S (ι s)) := fun s hs ↦
    (IsLocalization.AtPrime.isUnit_to_map_iff S M _).mpr hs
  refine le_antisymm ?_ ?_
  · intro x hx
    obtain ⟨⟨m, t⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl x
    dsimp only at hx ⊢
    have hm : m ∈ M := (IsLocalization.AtPrime.mk'_mem_maximal_iff S M m t).mp hx
    have hvM : v.map ι ≤ M := Ideal.map_le_iff_le_comap.mpr le_rfl
    obtain ⟨s, hs, hsm⟩ := exists_notMem_mul_mem_map v M hvM hm
    have hJ : (v.map ι).map (algebraMap _ S) ≤
        Ideal.span {algebraMap _ S ((1 : K) ⊗ₜ[k] π)} := by
      rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      intro a ha
      obtain ⟨s₁, hs₁, b, hb⟩ := hπ a ha
      rw [Ideal.mem_comap, Ideal.mem_comap]
      have h1 : algebraMap _ S (ι s₁) * algebraMap _ S (ι a) =
          algebraMap _ S ((1 : K) ⊗ₜ[k] π) * algebraMap _ S (ι b) := by
        rw [← map_mul, ← map_mul, ← map_mul, hb, map_mul]
        rfl
      obtain ⟨u, hu⟩ := hunit s₁ hs₁
      rw [← hu] at h1
      rw [Ideal.mem_span_singleton']
      refine ⟨↑u⁻¹ * algebraMap _ S (ι b), ?_⟩
      calc ↑u⁻¹ * algebraMap _ S (ι b) * algebraMap _ S ((1 : K) ⊗ₜ[k] π)
          = ↑u⁻¹ * (algebraMap _ S ((1 : K) ⊗ₜ[k] π) * algebraMap _ S (ι b)) := by ring
        _ = algebraMap _ S (ι a) := by rw [← h1, ← mul_assoc, Units.inv_mul, one_mul]
    have h2 : algebraMap _ S (s * m) ∈ Ideal.span {algebraMap _ S ((1 : K) ⊗ₜ[k] π)} :=
      hJ (Ideal.mem_map_of_mem _ hsm)
    have hsu : IsUnit (algebraMap _ S s) := (IsLocalization.AtPrime.isUnit_to_map_iff S M _).mpr hs
    rw [map_mul, Ideal.unit_mul_mem_iff_mem _ hsu] at h2
    rw [IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ h2
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff S M _).mpr hπv

/-- **Local structure at points over closed points** (T2c, closed case): if `M` is a maximal
ideal of `K ⊗_k A` with `v = M ∩ A ≠ 0`, then the maximal ideal of `(K ⊗_k A)_M` is generated by
the image of a local uniformizer `π` of `A` at `v`. -/
theorem maximalIdeal_eq_span_closed [CharZero k] [Algebra.FiniteType k A] [IsDedekindDomain A]
    (M : Ideal (K ⊗[k] A)) [M.IsMaximal]
    (hv : M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A) ≠ ⊥) :
    ∃ π : A, π ≠ 0 ∧ π ∈ M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A) ∧
      maximalIdeal (Localization.AtPrime M) = Ideal.span
        {algebraMap _ (Localization.AtPrime M) ((1 : K) ⊗ₜ[k] π)} := by
  have : (M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A)).IsPrime :=
    Ideal.comap_isPrime _ _
  obtain ⟨π, hπ0, hπv, hπ⟩ := exists_local_uniformizer _ hv
  exact ⟨π, hπ0, hπv, maximalIdeal_eq_span_closed_of M hv hπv hπ⟩

omit [Algebra k A] in
/-- `1 ⊗ a` is a non-zero-divisor of `K ⊗_k A` when `a` is one of `A` (`K` is flat over `k`). -/
lemma one_tmul_mem_nonZeroDivisors {a : A} (ha : a ∈ nonZeroDivisors A) [Algebra k A] :
    (1 : K) ⊗ₜ[k] a ∈ nonZeroDivisors (K ⊗[k] A) := by
  have hinj : Function.Injective (LinearMap.lTensor K (LinearMap.mulLeft k a)) :=
    Module.Flat.lTensor_preserves_injective_linearMap _ fun x y h ↦ by
      simpa using (mul_cancel_left_mem_nonZeroDivisors ha).mp h
  have heq : ∀ x : K ⊗[k] A, LinearMap.lTensor K (LinearMap.mulLeft k a) x = (1 ⊗ₜ[k] a) * x := by
    intro x
    induction x with
    | zero => simp
    | tmul c b => simp
    | add x y hx hy => rw [map_add, hx, hy, mul_add]
  rw [mem_nonZeroDivisors_iff_right]
  intro x hx
  apply hinj
  rw [heq, map_zero, mul_comm, hx]

/-- **T2c, closed case**: at a maximal ideal `M` of `K ⊗_k A` over a nonzero prime of `A`, the
local ring is a discrete valuation ring, with uniformizer a local uniformizer of `A`. -/
theorem isDVR_closed [CharZero k] [Algebra.FiniteType k A] [IsDedekindDomain A]
    (M : Ideal (K ⊗[k] A)) [M.IsMaximal]
    (hv : M.comap (Algebra.TensorProduct.includeRight : A →ₐ[k] K ⊗[k] A) ≠ ⊥) :
    ∃ _ : IsDomain (Localization.AtPrime M), IsDiscreteValuationRing (Localization.AtPrime M) := by
  obtain ⟨π, hπ0, -, hmax⟩ := maximalIdeal_eq_span_closed M hv
  have : IsNoetherianRing (K ⊗[k] A) := Algebra.FiniteType.isNoetherianRing K _
  refine isDiscreteValuationRing_of_maximalIdeal_eq hmax ?_
  exact IsLocalization.map_nonZeroDivisors_le M.primeCompl _
    ⟨_, one_tmul_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hπ0), rfl⟩

end Closed

end OrbicurveCores.Transfer
