import OrbicurveCores.Genuine.Transfer.BaseChange
import OrbicurveCores.Genuine.Transfer.IsoRamification
import OrbicurveCores.Genuine.Hemi

/-!
# T2e: base change of `E ∖ 0` and `(E ∖ 0)/±1`

Let `E₀` be an elliptic curve over a field `k₀` of characteristic `0` and `K / k₀` a field
extension, `E_K` the base change. For every component `P` of `K ⊗ A_{E₀ ∖ 0}`, the coordinate
ring of `E_K ∖ 0` (the integral closure of `K[x]` in `K(E_K)`) is isomorphic to `P`
(`alphaX`): `K[x, y]/(W) → P` is injective (it is injective on `K[x]`, over which `P` is
integral), extends to fraction fields, and maps the integral closure into the integrally closed
`P`; it is onto since `P` is generated by the `1 ⊗ a`, `a = c/d` with `c, d ∈ k₀[x, y]/(W)`.
-/

open TensorProduct AffOrbicurve Polynomial

universe u v

namespace OrbicurveCores.Transfer

variable {k₀ : Type u} [Field k₀] (E₀ : WeierstrassCurve k₀)

attribute [local instance] FractionRing.liftAlgebra

/-- The coordinate ring `k₀[x, y]/(W)` inside the coordinate ring of `E₀ ∖ 0`. -/
noncomputable def kappa : E₀.toAffine.CoordinateRing →ₐ[k₀[X]] puncturedRing E₀ :=
  IsIntegralClosure.lift k₀[X] (puncturedRing E₀) E₀.toAffine.FunctionField

lemma algebraMap_kappa (c : E₀.toAffine.CoordinateRing) :
    algebraMap (puncturedRing E₀) E₀.toAffine.FunctionField (kappa E₀ c) =
      algebraMap E₀.toAffine.CoordinateRing E₀.toAffine.FunctionField c :=
  IsIntegralClosure.algebraMap_lift k₀[X] (puncturedRing E₀) E₀.toAffine.FunctionField c

/-- The coordinate `x` on `E₀ ∖ 0`. -/
noncomputable abbrev xA : puncturedRing E₀ := algebraMap k₀[X] (puncturedRing E₀) X

/-- The coordinate `y` on `E₀ ∖ 0`. -/
noncomputable abbrev yA : puncturedRing E₀ := kappa E₀ (AdjoinRoot.root E₀.toAffine.polynomial)

/-- The `x`-coordinate as a map `k₀[x] → k₀[E₀ ∖ 0]`. -/
noncomputable abbrev hemiMapPoly : k₀[X] →ₐ[k₀] puncturedRing E₀ :=
  IsScalarTower.toAlgHom k₀ k₀[X] (puncturedRing E₀)

lemma eval₂_yA :
    E₀.toAffine.polynomial.eval₂ (algebraMap k₀[X] (puncturedRing E₀)) (yA E₀) = 0 := by
  have := AdjoinRoot.aeval_eq (f := E₀.toAffine.polynomial) E₀.toAffine.polynomial
  rw [AdjoinRoot.mk_self] at this
  have h2 := congrArg (kappa E₀) this
  rw [map_zero, ← Polynomial.aeval_algHom_apply] at h2
  exact h2

variable {K : Type (max u v)} [Field K] [Algebra k₀ K]
variable {P : Type (max u v)} [CommRing P] [Algebra K P]
  (ρ : K ⊗[k₀] puncturedRing E₀ →ₐ[K] P)

/-- `K[x] → P`, `x ↦ 1 ⊗ x`. -/
noncomputable def psiPoly : K[X] →ₐ[K] P := Polynomial.aeval (ρ ((1 : K) ⊗ₜ[k₀] xA E₀))

lemma psiPoly_comp_map :
    (psiPoly E₀ ρ).toRingHom.comp (Polynomial.mapRingHom (algebraMap k₀ K)) =
      ρ.toRingHom.comp ((Algebra.TensorProduct.includeRight :
        puncturedRing E₀ →ₐ[k₀] K ⊗[k₀] puncturedRing E₀).toRingHom.comp
          (algebraMap k₀[X] (puncturedRing E₀))) := by
  refine Polynomial.ringHom_ext (fun c ↦ ?_) ?_
  · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C,
      AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, psiPoly, Polynomial.aeval_C]
    have hC : (C c : k₀[X]) = algebraMap k₀ k₀[X] c := rfl
    rw [hC, ← IsScalarTower.algebraMap_apply k₀ k₀[X] (puncturedRing E₀), AlgHom.commutes]
    have : (algebraMap k₀ (K ⊗[k₀] puncturedRing E₀) c) = algebraMap K _ (algebraMap k₀ K c) :=
      rfl
    rw [this, AlgHom.commutes]
  · simp [psiPoly]

/-- `K[x, y]/(W) → P`, `x ↦ 1 ⊗ x`, `y ↦ 1 ⊗ y`. -/
noncomputable def psi : (E₀.baseChange K).toAffine.CoordinateRing →+* P :=
  AdjoinRoot.lift (psiPoly E₀ ρ).toRingHom (ρ ((1 : K) ⊗ₜ[k₀] yA E₀)) (by
    rw [WeierstrassCurve.baseChange, WeierstrassCurve.Affine.map_polynomial, Polynomial.eval₂_map,
      psiPoly_comp_map]
    have h := Polynomial.hom_eval₂ E₀.toAffine.polynomial (algebraMap k₀[X] (puncturedRing E₀))
      (ρ.toRingHom.comp (Algebra.TensorProduct.includeRight :
        puncturedRing E₀ →ₐ[k₀] K ⊗[k₀] puncturedRing E₀).toRingHom) (yA E₀)
    rw [eval₂_yA, map_zero] at h
    exact h.symm)

lemma psi_of (g : K[X]) : psi E₀ ρ (AdjoinRoot.of _ g) = psiPoly E₀ ρ g :=
  AdjoinRoot.lift_of _

lemma psiPoly_eq :
    psiPoly E₀ ρ = ρ.comp ((bcMap K (hemiMapPoly E₀)).comp (polyEquivTensor' k₀ K).toAlgHom) := by
  refine Polynomial.algHom_ext ?_
  simp only [psiPoly, Polynomial.aeval_X, AlgHom.comp_apply]
  show _ = ρ (bcMap K _ (polyEquivTensor k₀ K X))
  rw [polyEquivTensor_apply, eval₂_X, bcMap_tmul]
  rfl

/-- `K[x] → P` is injective when `ker ρ` is a minimal prime: its contraction to the domain
`K ⊗ k₀[x] ≅ K[x]` is a minimal prime, hence `0`. -/
lemma psiPoly_injective [CharZero k₀] [E₀.IsElliptic] [IsDomain P]
    (hρ : RingHom.ker ρ ∈ minimalPrimes (K ⊗[k₀] puncturedRing E₀)) :
    Function.Injective (psiPoly E₀ ρ) := by
  haveI : Algebra.FiniteType k₀ (puncturedRing E₀) := (punctured E₀).finiteType
  haveI : IsDedekindDomain (puncturedRing E₀) := (punctured E₀).isDedekindDomain
  have hfin : (hemiMapPoly E₀).toRingHom.Finite := hom_finite (Genuine.hemiHom E₀)
  have hmin := comap_bcMap_mem_minimalPrimes (K := K) (hemiMapPoly E₀) hfin
    (Polynomial.not_isField k₀) (punctured E₀).not_isField hρ
  have : IsDomain (K ⊗[k₀] k₀[X]) :=
    (polyEquivTensor' k₀ K).symm.toMulEquiv.isDomain
  have hbot : (RingHom.ker ρ).comap (bcMap K (hemiMapPoly E₀)) = ⊥ :=
    le_antisymm (hmin.2 ⟨Ideal.isPrime_bot, bot_le⟩ bot_le) bot_le
  have hinj : Function.Injective (ρ.comp (bcMap K (hemiMapPoly E₀))) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    have : x ∈ (RingHom.ker ρ).comap (bcMap K (hemiMapPoly E₀)) := hx
    rwa [hbot, Ideal.mem_bot] at this
  rw [psiPoly_eq, ← AlgHom.comp_assoc, AlgHom.coe_comp]
  exact hinj.comp (polyEquivTensor' k₀ K).injective

/-- `K[x, y]/(W) → P` is injective. -/
lemma psi_injective [CharZero k₀] [E₀.IsElliptic] [IsDomain P]
    (hρ : RingHom.ker ρ ∈ minimalPrimes (K ⊗[k₀] puncturedRing E₀)) :
    Function.Injective (psi E₀ ρ) := by
  rw [injective_iff_map_eq_zero]
  intro c hc
  have hker : RingHom.ker (psi E₀ ρ) = ⊥ := by
    have : (RingHom.ker (psi E₀ ρ)).IsPrime := RingHom.ker_isPrime _
    refine Ideal.eq_bot_of_comap_eq_bot (R := K[X]) ?_
    rw [eq_bot_iff]
    intro g hg
    rw [Ideal.mem_comap, RingHom.mem_ker] at hg
    rw [Ideal.mem_bot]
    apply psiPoly_injective E₀ ρ hρ
    rw [map_zero, ← psi_of]
    exact hg
  have : c ∈ RingHom.ker (psi E₀ ρ) := hc
  rwa [hker, Ideal.mem_bot] at this

/-- `P` as a `K[x]`-algebra. -/
@[reducible] noncomputable def algKP : Algebra K[X] P := (psiPoly E₀ ρ).toRingHom.toAlgebra

/-- `P` is integral over `K[x]` when `ρ` is surjective. -/
lemma isIntegral_P (hsurj : Function.Surjective ρ) :
    letI := algKP E₀ ρ; Algebra.IsIntegral K[X] P := by
  letI := algKP E₀ ρ
  have h1 : ∀ a : puncturedRing E₀, IsIntegral K[X] (ρ ((1 : K) ⊗ₜ[k₀] a)) := by
    intro a
    obtain ⟨p, hp, hpa⟩ := (Algebra.IsIntegral.isIntegral (R := k₀[X]) a :)
    refine ⟨p.map (Polynomial.mapRingHom (algebraMap k₀ K)), hp.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    change eval₂ ((psiPoly E₀ ρ).toRingHom.comp _) _ p = 0
    rw [psiPoly_comp_map]
    have h := Polynomial.hom_eval₂ p (algebraMap k₀[X] (puncturedRing E₀))
      (ρ.toRingHom.comp (Algebra.TensorProduct.includeRight :
        puncturedRing E₀ →ₐ[k₀] K ⊗[k₀] puncturedRing E₀).toRingHom) a
    rw [hpa, map_zero] at h
    exact h.symm
  refine ⟨fun x ↦ ?_⟩
  obtain ⟨z, rfl⟩ := hsurj x
  induction z with
  | zero => rw [map_zero]; exact isIntegral_zero
  | add x y hx hy => rw [map_add]; exact hx.add hy
  | tmul c a =>
    have : (c ⊗ₜ[k₀] a : K ⊗[k₀] puncturedRing E₀) = algebraMap K _ c * ((1 : K) ⊗ₜ[k₀] a) := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
        one_mul]
      rfl
    rw [this, map_mul, AlgHom.commutes, IsScalarTower.algebraMap_apply K K[X] P]
    · exact isIntegral_algebraMap.mul (h1 a)

/-- `psi` restricted to `k₀[x, y]/(W)` is `1 ⊗ κ`. -/
lemma psi_map (c : E₀.toAffine.CoordinateRing) :
    psi E₀ ρ (WeierstrassCurve.Affine.CoordinateRing.map E₀ (algebraMap k₀ K) c) =
      ρ ((1 : K) ⊗ₜ[k₀] kappa E₀ c) := by
  have h : (psi E₀ ρ).comp (WeierstrassCurve.Affine.CoordinateRing.map E₀ (algebraMap k₀ K)) =
      ρ.toRingHom.comp ((Algebra.TensorProduct.includeRight :
        puncturedRing E₀ →ₐ[k₀] K ⊗[k₀] puncturedRing E₀).toRingHom.comp
          (kappa E₀).toRingHom) := by
    refine AdjoinRoot.ringHom_ext (RingHom.ext fun g ↦ ?_) ?_
    · simp only [RingHom.comp_apply]
      rw [← AdjoinRoot.mk_C]
      change psi E₀ ρ (WeierstrassCurve.Affine.CoordinateRing.map E₀ (algebraMap k₀ K)
        (WeierstrassCurve.Affine.CoordinateRing.mk E₀ (C g))) = _
      rw [WeierstrassCurve.Affine.CoordinateRing.map_mk, Polynomial.map_C]
      change psi E₀ ρ (AdjoinRoot.of _ (g.map (algebraMap k₀ K))) = _
      rw [psi_of]
      have := congrArg (fun φ ↦ φ g) (psiPoly_comp_map E₀ ρ)
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom] at this
      refine this.trans ?_
      congr 2
      change _ = kappa E₀ (algebraMap k₀[X] _ g)
      rw [AlgHom.commutes]
    · simp only [RingHom.comp_apply]
      rw [← AdjoinRoot.mk_X]
      change psi E₀ ρ (WeierstrassCurve.Affine.CoordinateRing.map E₀ (algebraMap k₀ K)
        (WeierstrassCurve.Affine.CoordinateRing.mk E₀ X)) = _
      rw [WeierstrassCurve.Affine.CoordinateRing.map_mk, Polynomial.map_X]
      exact AdjoinRoot.lift_root _
  exact congrArg (fun φ ↦ φ c) h

section Alpha

variable [CharZero k₀] [E₀.IsElliptic] [IsDomain P]
  (hρ : RingHom.ker ρ ∈ minimalPrimes (K ⊗[k₀] puncturedRing E₀))

local notation "FK" => WeierstrassCurve.Affine.FunctionField
  (WeierstrassCurve.toAffine (WeierstrassCurve.baseChange E₀ K))
local notation "SK" => puncturedRing (E₀.baseChange K)

/-- `K(E_K) → Frac P`. -/
noncomputable def psiHat : FK →+* FractionRing P :=
  IsFractionRing.lift (A := (E₀.baseChange K).toAffine.CoordinateRing)
    (g := (algebraMap P (FractionRing P)).comp (psi E₀ ρ))
    ((IsFractionRing.injective P (FractionRing P)).comp (psi_injective E₀ ρ hρ))

lemma psiHat_algebraMap (c : (E₀.baseChange K).toAffine.CoordinateRing) :
    psiHat E₀ ρ hρ (algebraMap _ FK c) = algebraMap P (FractionRing P) (psi E₀ ρ c) :=
  IsFractionRing.lift_algebraMap _ _

lemma psiHat_algebraMap_poly (g : K[X]) :
    psiHat E₀ ρ hρ (algebraMap K[X] FK g) = algebraMap P (FractionRing P) (psiPoly E₀ ρ g) := by
  rw [IsScalarTower.algebraMap_apply K[X] (E₀.baseChange K).toAffine.CoordinateRing FK,
    psiHat_algebraMap, ← psi_of]
  rfl

variable [IsIntegrallyClosed P] (hsurj : Function.Surjective ρ)

/-- The integral closure `K[E_K ∖ 0]` maps into `P` (`P` is integrally closed and integral over
`K[x]`). -/
noncomputable def alphaX : SK →+* P := by
  letI := algKP E₀ ρ
  haveI := isIntegral_P E₀ ρ hsurj
  letI : Algebra SK (FractionRing P) :=
    ((psiHat E₀ ρ hρ).comp (integralClosure K[X] FK).val.toRingHom).toAlgebra
  haveI : IsScalarTower K[X] SK (FractionRing P) := IsScalarTower.of_algebraMap_eq fun g ↦ by
    change _ = psiHat E₀ ρ hρ (algebraMap K[X] FK g)
    rw [psiHat_algebraMap_poly, IsScalarTower.algebraMap_apply K[X] P (FractionRing P)]
    rfl
  exact (IsIntegralClosure.lift K[X] P (FractionRing P) (S := SK)).toRingHom

lemma algebraMap_alphaX (z : SK) :
    algebraMap P (FractionRing P) (alphaX E₀ ρ hρ hsurj z) = psiHat E₀ ρ hρ (z : FK) := by
  letI := algKP E₀ ρ
  haveI := isIntegral_P E₀ ρ hsurj
  letI : Algebra SK (FractionRing P) :=
    ((psiHat E₀ ρ hρ).comp (integralClosure K[X] FK).val.toRingHom).toAlgebra
  haveI : IsScalarTower K[X] SK (FractionRing P) := IsScalarTower.of_algebraMap_eq fun g ↦ by
    change _ = psiHat E₀ ρ hρ (algebraMap K[X] FK g)
    rw [psiHat_algebraMap_poly, IsScalarTower.algebraMap_apply K[X] P (FractionRing P)]
    rfl
  exact IsIntegralClosure.algebraMap_lift K[X] P (FractionRing P) z

lemma alphaX_injective : Function.Injective (alphaX E₀ ρ hρ hsurj) := by
  intro z₁ z₂ h
  have := congrArg (algebraMap P (FractionRing P)) h
  rw [algebraMap_alphaX, algebraMap_alphaX] at this
  exact Subtype.ext ((psiHat E₀ ρ hρ).injective this)

lemma alphaX_algebraMap (g : K[X]) :
    alphaX E₀ ρ hρ hsurj (algebraMap K[X] SK g) = psiPoly E₀ ρ g := by
  apply IsFractionRing.injective P (FractionRing P)
  rw [algebraMap_alphaX]
  exact psiHat_algebraMap_poly E₀ ρ hρ g

omit [CharZero k₀] [E₀.IsElliptic] in
lemma kappa_eq_mul {a : puncturedRing E₀} {c d : E₀.toAffine.CoordinateRing}
    (hd : d ∈ nonZeroDivisors _)
    (hcd : algebraMap _ E₀.toAffine.FunctionField c / algebraMap _ E₀.toAffine.FunctionField d =
      (a : E₀.toAffine.FunctionField)) :
    kappa E₀ c = kappa E₀ d * a := by
  apply Subtype.ext
  have hd0 : algebraMap _ E₀.toAffine.FunctionField d ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hd
  have h1 := algebraMap_kappa E₀ c
  have h2 := algebraMap_kappa E₀ d
  change algebraMap (puncturedRing E₀) _ _ = algebraMap (puncturedRing E₀) _ (_ * _)
  rw [map_mul, h1, h2]
  rw [div_eq_iff hd0] at hcd
  rw [hcd, mul_comm]
  rfl

/-- `alphaX` is onto: `P` is generated by the `1 ⊗ a`, and `a = c/d` with `c, d` in the
Weierstrass coordinate ring. -/
lemma alphaX_surjective : Function.Surjective (alphaX E₀ ρ hρ hsurj) := by
  letI := algKP E₀ ρ
  haveI := isIntegral_P E₀ ρ hsurj
  have hcomm : ∀ g : K[X], psiHat E₀ ρ hρ (algebraMap K[X] FK g) =
      algebraMap K[X] (FractionRing P) g := fun g ↦ by
    rw [psiHat_algebraMap_poly, IsScalarTower.algebraMap_apply K[X] P (FractionRing P)]
    rfl
  let f : FK →ₐ[K[X]] FractionRing P := AlgHom.mk (psiHat E₀ ρ hρ) hcomm
  have h1 : ∀ a : puncturedRing E₀, ρ ((1 : K) ⊗ₜ[k₀] a) ∈ (alphaX E₀ ρ hρ hsurj).range := by
    intro a
    obtain ⟨c, d, hd, hcd⟩ := IsFractionRing.div_surjective
      (A := E₀.toAffine.CoordinateRing) (a : E₀.toAffine.FunctionField)
    have hκ := kappa_eq_mul E₀ hd hcd
    set cK : (E₀.baseChange K).toAffine.CoordinateRing :=
      WeierstrassCurve.Affine.CoordinateRing.map E₀ (algebraMap k₀ K) c
    set dK : (E₀.baseChange K).toAffine.CoordinateRing :=
      WeierstrassCurve.Affine.CoordinateRing.map E₀ (algebraMap k₀ K) d
    have hdK : dK ≠ 0 := by
      intro h
      apply nonZeroDivisors.ne_zero hd
      exact WeierstrassCurve.Affine.CoordinateRing.map_injective (algebraMap k₀ K).injective
        (h.trans (map_zero _).symm)
    have hpd : algebraMap P (FractionRing P) (psi E₀ ρ dK) ≠ 0 := by
      intro h
      apply hdK
      apply psi_injective E₀ ρ hρ
      have : psi E₀ ρ dK = 0 :=
        IsFractionRing.injective P (FractionRing P) (h.trans (map_zero _).symm)
      rw [this, map_zero]
    set z : FK := algebraMap _ FK cK / algebraMap _ FK dK
    have hz : psiHat E₀ ρ hρ z = algebraMap P (FractionRing P) (ρ ((1 : K) ⊗ₜ[k₀] a)) := by
      rw [map_div₀, psiHat_algebraMap, psiHat_algebraMap, div_eq_iff hpd, psi_map, psi_map, hκ,
        ← map_mul, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm]
    have hzint : IsIntegral K[X] z := by
      refine (isIntegral_algHom_iff f (psiHat E₀ ρ hρ).injective).mp ?_
      change IsIntegral K[X] (psiHat E₀ ρ hρ z)
      rw [hz]
      exact (Algebra.IsIntegral.isIntegral (R := K[X]) _).algebraMap
    refine ⟨⟨z, hzint⟩, ?_⟩
    apply IsFractionRing.injective P (FractionRing P)
    rw [algebraMap_alphaX]
    exact hz
  intro x
  obtain ⟨t, rfl⟩ := hsurj x
  induction t with
  | zero => exact ⟨0, by rw [map_zero, map_zero]⟩
  | add x y hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    exact ⟨a + b, by rw [map_add, map_add, ha, hb]⟩
  | tmul c a =>
    obtain ⟨b, hb⟩ := h1 a
    refine ⟨algebraMap K[X] SK (C c) * b, ?_⟩
    rw [map_mul, hb, alphaX_algebraMap, psiPoly, Polynomial.aeval_C, ← AlgHom.commutes ρ,
      ← map_mul, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
      mul_one, one_mul]
    rfl

end Alpha

end OrbicurveCores.Transfer
