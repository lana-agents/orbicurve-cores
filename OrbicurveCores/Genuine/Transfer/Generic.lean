import Mathlib.RingTheory.Kaehler.TensorProduct
import Mathlib.RingTheory.Unramified.Locus
import Mathlib.RingTheory.Unramified.LocalRing
import Mathlib.NumberTheory.RamificationInertia.Unramified

/-!
# T2c, generic case: unramifiedness survives base change

Let `T` be a base change (`Algebra.IsPushout D R' A T`) of a `D`-algebra `A`. If `a ∈ A` kills
`Ω[A/D]` (`A` is generically unramified over `D`), then the image of `a` kills `Ω[T/R']`, so
`T` is unramified over `R'` at every prime `M` not containing `a`; hence the maximal ideal of
`T_M` is generated by `M ∩ R'` (`map_comap_eq_maximalIdeal_of_smul_kaehler`).

In characteristic `0`, a domain `A` integral over a domain `D` is unramified at its generic point
(`Algebra.isUnramifiedAt_bot`), so some `a ≠ 0` kills `Ω[A/D]` when `A` is of finite type
(`exists_ne_zero_smul_kaehler_eq_zero`).
-/

open TensorProduct IsLocalRing

namespace OrbicurveCores.Transfer

section Pushout

variable {D R' A T : Type*} [CommRing D] [CommRing R'] [CommRing A] [CommRing T]
  [Algebra D R'] [Algebra D A] [Algebra D T] [Algebra R' T] [Algebra A T]
  [IsScalarTower D R' T] [IsScalarTower D A T] [Algebra.IsPushout D R' A T]

/-- If `a` kills `Ω[A/D]`, its image kills `Ω[T/R']` for the base change `T` of `A`. -/
lemma smul_kaehler_eq_zero_of_isPushout {a : A} (ha : ∀ ω : Ω[A⁄D], a • ω = 0)
    (x : Ω[T⁄R']) : algebraMap A T a • x = 0 := by
  obtain ⟨y, rfl⟩ := (KaehlerDifferential.tensorKaehlerEquiv D R' A T).surjective x
  rw [← LinearEquiv.map_smul]
  convert LinearEquiv.map_zero _
  induction y with
  | zero => rw [smul_zero]
  | add y z hy hz => rw [smul_add, hy, hz, add_zero]
  | tmul b ω =>
    rw [smul_tmul', smul_eq_mul, ← Algebra.smul_def, smul_tmul, ha, tmul_zero]

/-- **Unramifiedness after base change**: if `a` kills `Ω[A/D]` and `M` is a prime of the base
change `T` not containing `a`, then `T` is unramified over `R'` at `M`. -/
lemma isUnramifiedAt_of_smul_kaehler {a : A} (ha : ∀ ω : Ω[A⁄D], a • ω = 0) (M : Ideal T)
    [M.IsPrime] (haM : algebraMap A T a ∉ M) : Algebra.IsUnramifiedAt R' M := by
  have : (⟨M, ‹_›⟩ : PrimeSpectrum T) ∈ Algebra.unramifiedLocus R' T := by
    rw [Algebra.unramifiedLocus_eq_compl_support]
    exact Module.notMem_support_iff'.mpr fun m ↦ ⟨_, haM, smul_kaehler_eq_zero_of_isPushout ha m⟩
  exact this

/-- If `a` kills `Ω[A/D]` and `M` is a prime of the base change `T` not containing `a`, then the
maximal ideal of `T_M` is generated by `M ∩ R'`. -/
lemma map_comap_eq_maximalIdeal_of_smul_kaehler [Algebra.EssFiniteType R' T] {a : A}
    (ha : ∀ ω : Ω[A⁄D], a • ω = 0) (M : Ideal T) [M.IsPrime] (haM : algebraMap A T a ∉ M) :
    (M.comap (algebraMap R' T)).map (algebraMap R' (Localization.AtPrime M)) =
      maximalIdeal (Localization.AtPrime M) := by
  have hU := isUnramifiedAt_of_smul_kaehler (R' := R') ha M haM
  let p := M.comap (algebraMap R' T)
  let := Localization.AtPrime.algebraOfLiesOver p M
  exact ((Algebra.isUnramifiedAt_iff_map_eq R' p M).mp hU).2

end Pushout

/-- **Generic unramifiedness** (characteristic `0`): for a domain `A` of finite type, integral
and torsion-free over a domain `D`, some nonzero `a ∈ A` kills `Ω[A/D]`. -/
lemma exists_ne_zero_smul_kaehler_eq_zero {D A : Type*} [CommRing D] [CommRing A] [Algebra D A]
    [IsDomain D] [IsDomain A] [Module.IsTorsionFree D A] [CharZero D] [Algebra.IsIntegral D A]
    [Algebra.FiniteType D A] : ∃ a : A, a ≠ 0 ∧ ∀ ω : Ω[A⁄D], a • ω = 0 := by
  have hU : Algebra.IsUnramifiedAt D (⊥ : Ideal A) := Algebra.isUnramifiedAt_bot
  have hmem : (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum A) ∈ Algebra.unramifiedLocus D A := hU
  rw [Algebra.unramifiedLocus_eq_compl_support, Set.mem_compl_iff,
    Module.mem_support_iff_of_finite, SetLike.not_le_iff_exists] at hmem
  obtain ⟨a, ha, ha0⟩ := hmem
  exact ⟨a, ha0, fun ω ↦ Module.mem_annihilator.mp ha ω⟩

end OrbicurveCores.Transfer
