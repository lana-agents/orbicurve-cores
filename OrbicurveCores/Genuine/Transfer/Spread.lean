import OrbicurveCores.Genuine.Transfer.ModelOrbicurve
import OrbicurveCores.Genuine.Transfer.Embedding
import Mathlib.RingTheory.Extension.Presentation.Core
import Mathlib.SetTheory.Cardinal.Subfield

/-!
# T1b: spreading out

* `exists_subfield_complex`: a finite subset of a field `k` of characteristic `0` lies in the
  image of a subfield `k₀ ⊆ ℂ` under a field embedding `k₀ → k` (the subfield generated by the
  set is countable, hence embeds into `ℂ`, T1a);
* `exists_presentation`: a finitely generated algebra has a finite presentation whose generators
  include a prescribed finite family;
* `modelOfPresentation`: a presentation whose coefficients come from `k₀` gives a model over
  `k₀` (Mathlib's `Algebra.Presentation.ModelOfHasCoeffs`).
-/

open TensorProduct AffOrbicurve Cardinal

universe u

namespace OrbicurveCores.Transfer

/-- **A finite subset of a field of characteristic `0` comes from a subfield of `ℂ`.** -/
theorem exists_subfield_complex {k : Type u} [Field k] [CharZero k] (S : Set k) (hS : S.Finite) :
    ∃ (k₀ : Subfield ℂ) (ι : k₀ →+* k), S ⊆ Set.range ι := by
  set k₁ := Subfield.closure S
  have hc : #k₁ ≤ ℵ₀ :=
    (Subfield.cardinalMk_closure_le_max S).trans (max_le hS.lt_aleph0.le le_rfl)
  haveI : Countable k₁ := Cardinal.mk_le_aleph0_iff.mp hc
  obtain ⟨σ⟩ := nonempty_ringHom_complex k₁
  let e : k₁ ≃+* σ.fieldRange := σ.rangeRestrictFieldEquiv
  refine ⟨σ.fieldRange, k₁.subtype.comp e.symm.toRingHom, fun s hs ↦ ?_⟩
  refine ⟨e ⟨s, Subfield.subset_closure hs⟩, ?_⟩
  simp

/-- **Presentations with prescribed generators.** -/
theorem exists_presentation {k A : Type*} [Field k] [CommRing A] [Algebra k A]
    [Algebra.FiniteType k A] {n : ℕ} (s : Fin n → A) :
    ∃ (m r : ℕ) (P : Algebra.Presentation k A (Fin (n + m)) (Fin r)),
      ∀ i : Fin n, P.val (Fin.castAdd m i) = s i := by
  classical
  obtain ⟨T, hT⟩ := Algebra.FiniteType.out (R := k) (A := A)
  set m := T.card
  let t : Fin m → A := fun j ↦ (T.equivFin.symm j : A)
  let val : Fin (n + m) → A := Fin.append s t
  have hsurj : Function.Surjective (MvPolynomial.aeval (R := k) val) := by
    rw [← AlgHom.range_eq_top, eq_top_iff, ← hT, Algebra.adjoin_le_iff]
    intro a ha
    refine ⟨MvPolynomial.X (Fin.natAdd n (T.equivFin ⟨a, ha⟩)), ?_⟩
    simp [val, t, Fin.append_right]
  have hfg : (RingHom.ker (MvPolynomial.aeval (R := k) val)).FG := IsNoetherian.noetherian _
  obtain ⟨R, hR⟩ := hfg
  let G := Algebra.Generators.ofSurjective val hsurj
  refine ⟨m, R.card, { G with
    relation := fun j ↦ (R.equivFin.symm j : MvPolynomial (Fin (n + m)) k)
    span_range_relation_eq_ker := ?_ }, fun i ↦ ?_⟩
  · rw [G.ker_eq_ker_aeval_val]
    change _ = RingHom.ker (MvPolynomial.aeval val)
    rw [← hR]
    congr 1
    ext f
    simp only [Set.mem_range, Finset.mem_coe]
    refine ⟨fun ⟨j, hj⟩ ↦ hj ▸ (R.equivFin.symm j).2, fun hf ↦ ⟨R.equivFin ⟨f, hf⟩, by simp⟩⟩
  · change Fin.append s t (Fin.castAdd m i) = s i
    rw [Fin.append_left]

universe v

/-- **Models from presentations**: a presentation of a `k`-algebra `A` whose coefficients come
from a subfield `k₀` gives a model `A₀` over `k₀` (with `k ⊗ A₀ ≅ A`) whose image contains the
generators. -/
theorem exists_model {k₀ : Type u} [Field k₀] {k : Type (max u v)} [Field k] [Algebra k₀ k]
    {A : Type (max u v)} [CommRing A] [Algebra k A] {a b : ℕ}
    (P : Algebra.Presentation k A (Fin a) (Fin b))
    (hP : P.coeffs ⊆ Set.range (algebraMap k₀ k)) :
    ∃ (A₀ : Type u) (_ : CommRing A₀) (_ : Algebra k₀ A₀) (_ : Algebra.FiniteType k₀ A₀)
      (e : k ⊗[k₀] A₀ ≃ₐ[k] A), ∀ i, ∃ x : A₀, e ((1 : k) ⊗ₜ x) = P.val i := by
  letI : Algebra k₀ A := ((algebraMap k A).comp (algebraMap k₀ k)).toAlgebra
  haveI : IsScalarTower k₀ k A := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  haveI : P.HasCoeffs k₀ := ⟨hP⟩
  refine ⟨P.ModelOfHasCoeffs k₀, inferInstance, inferInstance, inferInstance,
    P.tensorModelOfHasCoeffsEquiv k₀, fun i ↦ ⟨Ideal.Quotient.mk _ (MvPolynomial.X i), ?_⟩⟩
  rw [Algebra.Presentation.tensorModelOfHasCoeffsEquiv_tmul, map_one, one_mul,
    MvPolynomial.aeval_X]

end OrbicurveCores.Transfer
